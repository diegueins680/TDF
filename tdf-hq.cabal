    Paths_tdf_hq
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base                 >=4.14 && <5
    , aeson                >=2.0
    , bytestring
    , case-insensitive
    , text
    , time
    , random
    , containers
    , gitrev
    , http-client
    , http-client-tls
    , persistent           >=2.14
    , persistent-template  >=2.12
    , persistent-postgresql >=2.13
    , persistent-sqlite     >=2.13
    , resource-pool
    , monad-logger
    , resourcet
    , conduit
    , servant              >=0.19
    , servant-server       >=0.19
    , servant-multipart
    , servant-multipart
    , postgresql-simple
    , http-types
    , http-media
    , warp                 >=3.3
    , wai
    , wai-cors
    , http2                >=5.0 && <5.3
    , entropy
    , filepath
    , directory
    , transformers
    , mtl
    , mime-mail
    , unordered-containers
    , uuid-types
    , scientific
    , safe-exceptions
    , base64-bytestring
    , base16-bytestring
    , directory
    , process
    , temporary
    , bcrypt
    , path-pieces
    , uuid
    , template-haskell
    , file-embed
    , smtp-mail
    , tagged
    , crypton
    , memory

