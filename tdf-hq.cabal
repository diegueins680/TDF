cabal-version:      2.4
name:               tdf-hq
version:            0.1.0.0
synopsis:           TDF HQ - CRM, Scheduling, Packages, Invoicing, Inventory (skeleton)
license:            MIT
author:             TDF Records (Diego Saá)
maintainer:         tdf@example.com
build-type:         Simple

executable tdf-hq-exe
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
    TDF.API.Admin
    TDF.API
    TDF.API.Bands
    TDF.API.Facebook
    TDF.API.Instagram
    TDF.API.InstagramOAuth
    TDF.API.Internships
    TDF.API.Future
