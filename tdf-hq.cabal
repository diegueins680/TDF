    TDF.API.Calendar
    TDF.API.Marketplace
    TDF.API.Label
    TDF.API.Drive
    TDF.API.Rooms
    TDF.API.Services
    TDF.API.Sessions
    TDF.API.Radio
    TDF.API.SocialSyncAPI
    TDF.Contracts.API
    TDF.Contracts.Server
    TDF.Contracts.Types
    TDF.API.SocialEventsAPI
    TDF.API.Types
    TDF.API.WhatsApp
    TDF.Auth
    TDF.Config
    TDF.Cron
    TDF.Cors
    TDF.DB
    TDF.DTO
    TDF.DTO.SocialEventsDTO
    TDF.DTO.SocialSyncDTO
    TDF.Email
    TDF.Handlers.InputList
    TDF.Invoice.SRI
