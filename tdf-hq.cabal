    TDF.Server
    TDF.ServerAuth
    TDF.ServerAdmin
    TDF.Server.SocialSync
    TDF.ServerExtra
    TDF.ServerInstagramOAuth
    TDF.ServerProposals
    TDF.ServerInternships
    TDF.Server.SocialEventsHandlers
    TDF.ServerLiveSessions
    TDF.ServerFeedback
    TDF.ServerRadio
    TDF.ServerFanClub
    TDF.ServerFuture
    TDF.Routes.Courses
    TDF.Trials.API
    TDF.Trials.DTO
    TDF.Trials.Models
    TDF.Trials.Seed
